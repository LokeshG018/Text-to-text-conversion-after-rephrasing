# Copy to .env and edit
DATABASE_URL=sqlite:///./rephraseai.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/rephraseai
JWT_SECRET=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720
MODEL_NAME=google/flan-t5-base
# Fine-tuned model (created by training/train_transformer.py) is used automatically if this folder exists
FINETUNED_MODEL_DIR=../models/flan-t5-paraphrase
DEVICE=auto
ENABLE_BERTSCORE=true
WARMUP_ON_STARTUP=false
CORS_ORIGINS=http://localhost:5173
